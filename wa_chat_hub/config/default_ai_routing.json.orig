{
  "WA AI Intent": [
    {
      "intent_name": "new_treatment_order_request",
      "intent_label": "New Treatment / Order Request",
      "is_active": 1,
      "priority": 100,
      "description": "The customer wants to begin treatment, obtain medicine, create a new case, or create a new order. Creation/treatment wording takes priority over incidental tracking wording.",
      "classifier_examples": "mujhe treatment lena hai mera order ceate krdo\npsoriasis ke liye medicine order kar do\nmera treatment start karna hai\ndawai bhej do\nnew order banao\ndoctor se treatment order create karwa do",
      "fallback_match": {
        "contains_any": [
          "new order",
          "order create",
          "order ceate",
          "order creat",
          "order banao",
          "order bnao",
          "order kar do",
          "order kr do",
          "case create",
          "case banao",
          "treatment lena",
          "treatment start",
          "medicine order",
          "medicin order",
          "medicine chahiye",
          "dawai chahiye",
          "dawa chahiye",
          "dawai bhej",
          "medicine bhej"
        ]
      },
      "confidence_threshold": 0.55,
      "requires_patient_data": 0,
      "is_default_fallback": 0,
      "clarification_prompt": "Please tell me whether you want to start a new treatment request or track an order that was already created."
    },
