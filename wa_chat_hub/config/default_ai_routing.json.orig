  "WA AI Workflow": [
    {
      "workflow_name": "Treatment Case Creation",
      "is_active": 1,
      "workflow_version": 1,
      "expiry_minutes": 1440,
      "action_tool": "create_verified_patient_draft_encounter",
      "definition": {
        "trigger": {
          "minimum_confidence": 0.55
        },
        "collect": [
          {
            "field": "customer_address",
            "prompt": "Before I create your treatment case, please share your complete address with house/flat number, area, city, state and PIN code.",
            "invalid_prompt": "Please share your complete address with house/flat number, area, city, state and six-digit PIN code before I create the treatment case.",
            "validation": {
              "min_length": 20,
              "max_length": 1000,
              "min_words": 5,
              "contains_digit": true,
              "contains_any": ["house", "flat", "plot", "door", "street", "road", "sector", "block", "village", "nagar", "colony", "lane", "floor", "near", "h no", "h.no"],
              "digit_group_lengths_any": [6]
            }
          }
        ],
        "confirmation": {
          "mode": "challenge",
          "challenge_length": 6,
          "prompt": "Please confirm that I should create your treatment case using this address: {customer_address}. Reply with this one-time confirmation code: {confirmation_code}",
          "invalid_prompt": "For your security, enter the exact one-time confirmation code from my previous message, or cancel this request.",
          "cancel_phrases": ["cancel", "stop", "nahi", "mat karo", "do not create"]
        },
        "arguments": {
          "encounter_reason": {"source": "origin_message", "default": "Treatment request from WhatsApp"},
          "customer_confirmed": {"source": "value", "value": 1},
          "customer_address": {"source": "collected", "field": "customer_address"},
          "encounter_type": {"source": "value", "value": "Followup"},
          "encounter_place": {"source": "value", "value": "Online"},
          "complaints": {"source": "origin_message", "default": "Treatment enquiry from WhatsApp"}
        },
        "messages": {
          "success": "Your treatment case has been created successfully. Our care team can now review the details and guide you further.",
          "cancelled": "Okay, I have cancelled this treatment-case creation request.",
          "error": "I could not create the treatment case safely right now. I have noted the request for our care team to assist you.",
          "unavailable": "I cannot create the treatment case safely on this channel right now. I have kept your request for the care team to assist.",
          "expired": "The previous confirmation expired for security. Please ask me to create the treatment case again."
        }
      }
    }
  ],
