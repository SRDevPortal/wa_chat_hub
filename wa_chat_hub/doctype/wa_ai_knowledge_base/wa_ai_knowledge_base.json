{
  "doctype": "DocType",
  "name": "WA AI Knowledge Base",
  "module": "WA Chat Hub",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "kb_label",
    "kb_type",
    "department",
    "source_path",
    "source_url",
    "content",
    "priority",
    "is_active"
  ],
  "fields": [
    {
      "fieldname": "kb_label",
      "fieldtype": "Data",
      "label": "Knowledge Base Label",
      "reqd": 1
    },
    {
      "fieldname": "kb_type",
      "fieldtype": "Select",
      "label": "Knowledge Base Type",
      "options": "FAQ\nSOP\nDepartment Playbook\nTreatment Safety Guide\nWebsite\nDocument\nAPI Spec\nPrompt Pack",
      "reqd": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "source_path",
      "fieldtype": "Data",
      "label": "Source Path"
    },
    {
      "fieldname": "source_url",
      "fieldtype": "Data",
      "label": "Source URL"
    },
    {
      "fieldname": "content",
      "fieldtype": "Long Text",
      "label": "Inline Content"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Int",
      "label": "Priority",
      "default": 10
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active",
      "default": 1
    }
  ],
  "permissions": []
}