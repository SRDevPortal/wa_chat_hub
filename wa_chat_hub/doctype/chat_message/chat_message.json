{
  "doctype": "DocType",
  "name": "Chat Message",
  "module": "WA Chat Hub",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "conversation",
    "direction",
    "sender_type",
    "content_type",
    "body",
    "media_url",
    "channel_message_id",
    "delivery_status",
    "raw_payload"
  ],
  "fields": [
    {
      "fieldname": "conversation",
      "fieldtype": "Link",
      "label": "Conversation",
      "options": "Chat Conversation",
      "reqd": 1
    },
    {
      "fieldname": "direction",
      "fieldtype": "Select",
      "label": "Direction",
      "options": "Inbound\nOutbound\nInternal Note",
      "reqd": 1
    },
    {
      "fieldname": "sender_type",
      "fieldtype": "Select",
      "label": "Sender Type",
      "options": "Customer\nAgent\nAI\nSystem"
    },
    {
      "fieldname": "content_type",
      "fieldtype": "Select",
      "label": "Content Type",
      "options": "Text\nImage\nVideo\nAudio\nDocument\nTemplate\nLocation",
      "default": "Text"
    },
    {
      "fieldname": "body",
      "fieldtype": "Long Text",
      "label": "Body"
    },
    {
      "fieldname": "media_url",
      "fieldtype": "Data",
      "label": "Media URL"
    },
    {
      "fieldname": "channel_message_id",
      "fieldtype": "Data",
      "label": "Channel Message ID"
    },
    {
      "fieldname": "delivery_status",
      "fieldtype": "Select",
      "label": "Delivery Status",
      "options": "Pending\nSent\nDelivered\nRead\nFailed",
      "default": "Pending"
    },
    {
      "fieldname": "raw_payload",
      "fieldtype": "Code",
      "label": "Raw Payload",
      "options": "JSON"
    }
  ],
  "permissions": []
}