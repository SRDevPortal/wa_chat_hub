{
  "doctype": "DocType",
  "name": "Chat Action Log",
  "module": "WA Chat Hub",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "conversation",
    "action_type",
    "reference_doctype",
    "reference_name",
    "action_payload"
  ],
  "fields": [
    {
