      "label": "Reference Doctype"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Data",
      "label": "Reference Name"
    },
    {
      "fieldname": "action_payload",
      "fieldtype": "Code",
      "label": "Action Payload",
      "options": "JSON"
